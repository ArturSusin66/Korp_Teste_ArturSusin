# Variáveis de Ambiente - Copie para .env e configure

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Credenciais MySQL (Docker)
MYSQL_ROOT_PASSWORD=sua_senha_root
MYSQL_USER=korp
MYSQL_PASSWORD=sua_senha_korp

# Banco de Dados - Connection Strings
ESTOQUE_DATABASE_CONNECTION=Server=localhost;Database=EstoqueDb;User=korp;Password=sua_senha;Charset=utf8mb4;
FATURAMENTO_DATABASE_CONNECTION=Server=localhost;Database=FaturamentoDb;User=korp;Password=sua_senha;Charset=utf8mb4;

# URLs dos Serviços
ESTOQUE_BASE_URL=http://localhost:5001
FATURAMENTO_BASE_URL=http://localhost:5002

# Logging
LOG_LEVEL=Information

# Timeout e Resiliência
HTTP_TIMEOUT=5
RETRY_COUNT=3
RETRY_DELAY_MS=2000