# Variáveis de Ambiente - Copie para .env e configure

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Banco de Dados - Estoque
ESTOQUE_DATABASE_CONNECTION=Server=localhost;Database=EstoqueDb;User=root;Password=sua_senha;Charset=utf8mb4;

# Banco de Dados - Faturamento
FATURAMENTO_DATABASE_CONNECTION=Server=localhost;Database=FaturamentoDb;User=root;Password=sua_senha;Charset=utf8mb4;

# URLs dos Serviços
ESTOQUE_BASE_URL=http://localhost:5000
FATURAMENTO_BASE_URL=http://localhost:5001

# Logging
LOG_LEVEL=Information

# Timeout de Requisições (segundos)
HTTP_TIMEOUT=5

# Retry Policy (tentativas)
RETRY_COUNT=3
RETRY_DELAY_MS=2000